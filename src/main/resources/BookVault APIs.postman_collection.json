                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Token exists', function () { pm.expect(json.data.token).to.exist; });",
                  "pm.collectionVariables.set('librarianToken', json.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
